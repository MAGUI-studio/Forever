# Configuração pública do app Web (Firebase > Configurações do projeto > Seus apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Conta de serviço: somente no servidor. Nunca use NEXT_PUBLIC nestes campos.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Copie private_key do JSON; mantenha as quebras como \n dentro de aspas duplas.
FIREBASE_PRIVATE_KEY=""
# Superadministradores da MAGUI.studio (UIDs separados por vírgula).
MAGUI_ADMIN_UIDS=
# Somente para a migração inicial do casamento legado.
FIREBASE_ADMIN_UIDS=
# Bucket do Firebase Storage para imagens (ex.: projeto.firebasestorage.app).
FIREBASE_STORAGE_BUCKET=

# Somente desenvolvimento. Em produção os links usam sempre https://forever.magui.studio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# UploadThing
UPLOADTHING_TOKEN=
