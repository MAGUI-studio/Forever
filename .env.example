# Configuração pública do app Web (Firebase > Configurações do projeto > Seus apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Conta de serviço: somente no servidor. Nunca use NEXT_PUBLIC nestes campos.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Copie private_key do JSON; mantenha as quebras como \n dentro de aspas duplas.
FIREBASE_PRIVATE_KEY=""
# UIDs das duas contas, separados por vírgula (Authentication > Users).
FIREBASE_ADMIN_UIDS=

# URL usada nos links e QR Codes dos convites. Em produção, configure o domínio público antes do build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
